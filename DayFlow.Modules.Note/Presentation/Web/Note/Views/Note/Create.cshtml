}

<nav aria-label="breadcrumb">
	<ol class="breadcrumb">
		<li class="breadcrumb-item">
			<a asp-controller="Notebook"
			   asp-action="Index">
				筆記本
			</a>
		</li>

		<li class="breadcrumb-item active">
