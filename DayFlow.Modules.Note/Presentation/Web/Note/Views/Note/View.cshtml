@model DayFlow.Modules.Notes.Presentation.Web.Note.ViewModels.NoteEditViewModel

@{
	ViewData["Title"] = "筆記內容";
}

<nav aria-label="breadcrumb">
	<ol class="breadcrumb">

		<li class="breadcrumb-item">
			<a asp-controller="Notebook"
			   asp-action="Index">
				筆記本
			</a>
		</li>

		<li class="breadcrumb-item">
			<a asp-action="Index"
			   asp-route-notebookId="@Model.NotebookId">
				@Model.NotebookName
			</a>
		</li>

		<li class="breadcrumb-item active">
			@Model.Title
		</li>

	</ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">

	<h2>@Model.Title</h2>

	<div>

		<a asp-action="Edit"
		   asp-route-id="@Model.NoteId"
		   asp-route-notebookId="@Model.NotebookId"
		   class="btn btn-warning">

			編輯

		</a>

		<a asp-action="Index"
		   asp-route-notebookId="@Model.NotebookId"
		   class="btn btn-secondary">

			返回

		</a>

	</div>

</div>

<div class="alert alert-light border mb-4">

	<strong>
		<label asp-for="Title"></label>
	</strong>

	<div class="mt-2">
		@Html.Raw(Model.Title)
	</div>

</div>

<div class="alert alert-light border mb-4">

	<strong>
		<label asp-for="Content"></label>
	</strong>

	<div class="mt-2">
		@Html.Raw(Model.Content)
	</div>

</div>

<div class="alert alert-light border mb-4">

	<strong>
		<label asp-for="Summary"></label>
	</strong>

	<div class="mt-2">
		@Model.Summary
	</div>

</div>
