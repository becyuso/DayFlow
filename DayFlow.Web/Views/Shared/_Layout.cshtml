@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - DayFlow.Web</title>
	<script type="importmap"></script>
	@if (Env.IsDevelopment())
	{
		<script type="module"
				src="http://localhost:5173/app/main.ts">
		</script>
	}
	else
	{
		<script type="module"
				src="@Html.ViteScript("app/main.ts")">
		</script>
	}
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/DayFlow.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
			<div class="container-fluid">

				<a class="navbar-brand"
				   asp-area=""
				   asp-controller="Home"
				   asp-action="Index">
					DayFlow.Web
				</a>

				<button class="navbar-toggler"
						type="button"
						data-bs-toggle="collapse"
						data-bs-target=".navbar-collapse">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link text-dark"
							   asp-controller="Notebook"
							   asp-action="Index">
								Notebook
							</a>
						</li>
					</ul>

					<ul class="navbar-nav">

						@if (User?.Identity?.IsAuthenticated ?? false)
						{
							<li class="nav-item">
								<form method="post"
									  asp-controller="Account"
									  asp-action="Logout">

									<button type="submit"
											class="btn btn-link nav-link">
										Logout (@User.Identity.Name)
									</button>
								</form>
							</li>
						}
						else
						{
							<li class="nav-item">

								<a class="nav-link text-dark"
								   asp-controller="Account"
								   asp-action="SignIn">
									SignIn
								</a>
							</li>
						}
					</ul>
				</div>
			</div>
		</nav>
	</header>

	<div class="container flex-fill">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	@* Toast *@
	@await Component.InvokeAsync("Toast")

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2026 - DayFlow.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
